{
  "name": "helios",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:diff": "uvx diff-cover coverage/cobertura-coverage.xml --compare-branch=main --fail-under=100",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.6"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "resize-observer-polyfill": "^1.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  }
}
